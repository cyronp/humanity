{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ANTHROPIC_*", "CLAUDE_CONFIG_DIR", "GITHUB_TOKEN", "HUMANITY_*"]
    },
    "dev:desktop": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HUMANITY_*"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "env": ["HUMANITY_HOME"]
    }
  }
}
