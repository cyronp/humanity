{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": ["eslint.config.js", "tsconfig.base.json"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@humanity/web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/desktop/package.json"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ANTHROPIC_*", "CLAUDE_CONFIG_DIR", "GITHUB_TOKEN", "HUMANITY_*"]
    },
    "dev:desktop": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HUMANITY_*"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["HUMANITY_HOME"],
      "passThroughEnv": ["PSModulePath", "PSModuleAnalysisCachePath"]
    }
  }
}
